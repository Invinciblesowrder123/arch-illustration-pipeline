# ===== 首次运行 python main.py 会引导你只填一次 API Key 并自动生成本文件 =====
# 以下为默认值（服务商 aixw，OpenAI 兼容协议）：
#   语言模型: gpt-5.6-sol
#   绘图模型: gpt-image-2
#   视觉校验: 复用语言模型 gpt-5.6-sol

LLM_BASE_URL=https://api.aixw.org/v1
LLM_API_KEY=sk-在这里填入你的aixw密钥
LLM_MODEL=gpt-5.6-sol

# ---- 绘图模型（留空则复用上面的地址与密钥）----
IMG_BASE_URL=
IMG_API_KEY=
IMG_MODEL=gpt-image-2
IMG_SIZE=1024x1024

# ---- 视觉校验模型（必须支持读图；留空则复用语言模型）----
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ---- 流程参数 ----
MAX_ATTEMPTS=3
SEARCH_ENABLED=1
SEARCH_TOP_K=5
# 联网补充知识用的 HTTP 代理（国内网络访问搜索引擎通常需要；留空=直连）
SEARCH_PROXY=
PER_FILE_CHAR_LIMIT=30000

# ---- 图内文字策略（T2）----
# caption_only（默认，建议）：图内不出现任何文字，标注改走图下图注表（编号↔名称）——
#   这也是考古线图的学术惯例，且能绕开"文生图模型渲染中文常出错字"的问题；
# in_image：图内标注写在图上，强制简体中文，校验会检查语言与可读性（有乱码/英文即不通过）。
# 两种模式都跑一遍给教授挑，比争论哪个更好更快。
TEXT_MODE=caption_only

# ---- 客户端超时与重试（T5，秒；单位：秒）----
# 上游（aixw）偶发风控判定会把单次调用拖到 70s+，超时设小会把"上游慢"误报成"链路不通"。
LLM_TIMEOUT=300
# 知识学习阶段读的文献多、上下文长，默认给更长的超时
LLM_TIMEOUT_KNOWLEDGE=600
VISION_TIMEOUT=300
IMG_TIMEOUT=300
# 失败自动重试次数（网络抖动/限流时的兜底）
LLM_RETRIES=2

# ---- 扫描版 PDF（无文字层）处理 ----
# MinerU 可执行文件路径（留空则自动探测：PATH > 当前环境库 > 常见 venv 目录）
MINERU_CMD=
# MinerU 后端：pipeline=经典模型 CPU 可跑（默认）；vlm-engine/hybrid-engine 需 GPU
MINERU_BACKEND=pipeline
# MinerU 单篇解析超时（秒）
MINERU_TIMEOUT=900

# ---- RAGFlow 知识层（--mode rag；三项配齐后自动启用 rag 模式）----
# RAGFlow 服务地址，如 http://192.168.1.100 （不带 /api/v1 后缀）
RAGFLOW_BASE_URL=
# RAGFlow 系统设置里生成的 API Key
RAGFLOW_API_KEY=
# dataset ID，多个用分号分隔，如 ds-abc123;ds-def456
RAGFLOW_DATASET_ID=
# 每组查询返回的片段数上限（同时决定候选池大小 knn_top_k）
RETRIEVAL_TOP_K=12
# 单次检索实际返回的片段数（RAGFlow 的 page_size）
RETRIEVAL_PAGE_SIZE=12
# 相似度阈值（低于此值的片段丢弃）
RETRIEVAL_SIM_THRESHOLD=0.2
# 检索请求超时（秒）
RAGFLOW_TIMEOUT=60
# 知识层模式：rag 走 RAGFlow 检索 / local 直读 references 目录
# 留空 = 自动（RAGFlow 三项配齐则用 rag，否则 local）；也可用 --mode 显式指定
PIPELINE_MODE=
# 配好以上三项后：python main.py --check 会自动追加"RAGFlow 知识层"自检项
# （校验鉴权、dataset 是否存在、并真实检索一次，零模型费用）；
# 只想单测检索通路：python main.py --dry-run --mode rag
